# Settings of the Phorge container. Copy this file to
# ~/.config/containers/systemd/phorge.container.d/settings.conf, remove the "#"
# in front of the lines to change and set the values. The values below are the
# defaults.

[Container]
# Address and port on the host on which Phorge listens. The empty line removes
# the default; without it Phorge listens on both ports.
#PublishPort=
#PublishPort=127.0.0.1:8080:80

# Address under which browsers reach Phorge, with the port when it is not 80 or
# 443. The host name needs at least one dot. Use "https" only when a reverse
# proxy that ends the TLS connection is in front of the container.
#Environment=PHORGE_BASE_URI=http://phorge.localhost:8080/

# Time zone that Phorge displays to users who have not chosen one.
#Environment=PHORGE_TIMEZONE=UTC

# Number of reverse proxies in front of the container that add the address of
# their client to the X-Forwarded-For header. Phorge takes the address of the
# client from that header when the number is not 0. Set it only when the port
# of PublishPort cannot be reached without passing these proxies: a client that
# connects directly can put any address in the header.
#Environment=PHORGE_TRUSTED_PROXIES=0
