# Settings of the compose file. Every variable is optional; the values below
# are the defaults. To change one, copy this file to ".env", remove the "#" in
# front of the variable and set the value.

# Address and port on the host on which Phorge listens.
#PHORGE_LISTEN=127.0.0.1:8080

# Address under which browsers reach Phorge, with the port when it is not 80 or
# 443. The host name needs at least one dot.
#PHORGE_BASE_URI=http://phorge.localhost:8080/

# Time zone that Phorge displays to users who have not chosen one.
#PHORGE_TIMEZONE=UTC
